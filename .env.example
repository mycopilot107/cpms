APP_NAME="Best CPMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://bestcpms.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — used for password-reset links, contact / feedback notifications, etc.
# The dev default "log" writes outgoing mail to storage/logs/laravel.log instead
# of sending it, so you can test the forgot-password flow without a mail server.
# To send real email, set MAIL_MAILER=smtp and fill in your SMTP details, e.g.:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.yourprovider.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-smtp-username
#   MAIL_PASSWORD=your-smtp-password
#   MAIL_SCHEME=smtp            # use "smtps" for implicit TLS on port 465
#   MAIL_FROM_ADDRESS="no-reply@bestcpms.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Razorpay payment gateway (subscription billing).
# Get test keys from https://dashboard.razorpay.com/app/keys — use rzp_test_*
# in development and live keys in production. Never commit real keys.
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Webhook secret from Razorpay Dashboard → Settings → Webhooks.
# Endpoint: {APP_URL}/api/webhooks/razorpay
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Optional: override the billing currency (defaults to INR).
# BILLING_CURRENCY=INR

# ----------------------------------------------------------------------------
# Social login (OAuth). Create app credentials in the provider consoles:
#   Google   -> https://console.cloud.google.com/apis/credentials
#   Facebook -> https://developers.facebook.com/apps  (add "Facebook Login")
# In each console, register the matching *_REDIRECT_URI below as an authorized
# redirect URI. Leave a provider's ID/secret blank to disable its button.
# Never commit real client secrets — they belong only in your local .env.
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Public footer social links (optional marketing profiles — NOT the login
# providers above). Uncomment and set your real profile URLs. If left unset,
# each footer icon falls back to its platform home page.
# SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/your-company
# SOCIAL_TWITTER_URL=https://twitter.com/yourhandle
# SOCIAL_FACEBOOK_URL=https://www.facebook.com/yourpage
# SOCIAL_INSTAGRAM_URL=https://www.instagram.com/yourhandle

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Brand & SEO (public marketing site). APP_URL above drives canonical URLs,
# sitemap.xml, robots.txt and Open Graph tags — set it to your live domain
# (https://bestcpms.com). These override the defaults in config/seo.php.
# Run `php artisan config:clear` after changing them.
# ----------------------------------------------------------------------------
SEO_SITE_NAME="Best CPMS"
SEO_ORG_LEGAL_NAME="Best CPMS"
# SEO_TAGLINE="Construction Project Management Software"
# SEO_OG_IMAGE=/og-image.png
# SEO_TWITTER_HANDLE=
